DATABASE_URL="file:./dev.db"

ADMIN_PASSWORD=hier_dein_passwort_eintragen

# E-Mail & URL Konfiguration
BASE_URL=https://domain.de

SMTP_HOST=smtp.dein-provider.de
SMTP_PORT=587
SMTP_USER=deine-email@domain.de
SMTP_PASS=dein-mail-passwort
SMTP_FROM="RSVP Team <deine-email@domain.de>"

CRON_SECRET=hier_cron_secret_eintragen

# Angaben fürs Impressum (/impressum). Bleiben hier als Platzhalter im Git-Repo -
# trag deine echten Daten nur in deiner lokalen/produktiven .env ein (wird nicht committed).
IMPRESSUM_NAME=Vorname Nachname
IMPRESSUM_STREET=Musterstraße 1
IMPRESSUM_ZIP=12345
IMPRESSUM_CITY=Musterstadt
IMPRESSUM_EMAIL=deine-email@domain.de
IMPRESSUM_PHONE=Optional