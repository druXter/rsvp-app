DATABASE_URL="file:./dev.db"

# E-Mail & URL Konfiguration
BASE_URL=https://domain.de

SMTP_HOST=smtp.dein-provider.de
SMTP_PORT=587
SMTP_USER=deine-email@domain.de
SMTP_PASS=dein-mail-passwort
SMTP_FROM="RSVP Team <deine-email@domain.de>"

# Muss gesetzt sein - ein leeres oder fehlendes Secret lässt die Cron-Endpunkte (/api/cron/*) niemanden durch.
CRON_SECRET=hier_cron_secret_eintragen

# Angaben fürs Impressum (/impressum). Bleiben hier als Platzhalter im Git-Repo -
# trag deine echten Daten nur in deiner lokalen/produktiven .env ein (wird nicht committed).
IMPRESSUM_NAME=Vorname Nachname
IMPRESSUM_STREET=Musterstraße 1
IMPRESSUM_ZIP=12345
IMPRESSUM_CITY=Musterstadt
IMPRESSUM_EMAIL=deine-email@domain.de
IMPRESSUM_PHONE=Optional

# VAPID-Keys für Web-Push-Benachrichtigungen (Admin-Dashboard). Selbst generieren mit:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY ist unkritisch (wird an den Browser ausgeliefert), VAPID_PRIVATE_KEY ist ein Geheimnis.
VAPID_PUBLIC_KEY=hier_deinen_generierten_public_key_eintragen
VAPID_PRIVATE_KEY=hier_deinen_generierten_private_key_eintragen
VAPID_SUBJECT=mailto:deine-email@domain.de

# Gemeinsames Secret mit dem separaten "abstimmungstool" - nur relevant, wenn ein
# Event/Termin einen Abstimmungs-Link (pollUrl) hat. Muss exakt mit dessen
# RSVP_VERIFICATION_SECRET übereinstimmen. Ohne dieses Secret wird der Link
# trotzdem angezeigt, nur ohne automatische Übernahme der Verifizierung.
POLL_VERIFICATION_SECRET=hier_gemeinsames_secret_mit_abstimmungstool_eintragen

# Basis-URL des separaten abstimmungstool für die aktive Zu-/Absage-Meldung (siehe
# app/lib/poll-notify.ts) - nur relevant für Events mit pollUrl. Ohne Wert bleibt
# diese Meldung einfach aus, kein Fehler.
ABSTIMMUNGSTOOL_BASE_URL=https://vote.deine-domain.de

# Wie viele Reverse Proxys (z.B. Nginx Proxy Manager, Cloudflare) vor dieser App stehen. Bestimmt, welcher
# Eintrag von X-Forwarded-For als Besucher-IP für die Anmelde-Drosselung gilt (von rechts gezählt - links steht
# Beliebiges, das der Client selbst mitschicken kann). 1 = ein Proxy. 0 = direkter Zugriff ohne Proxy (der Header
# wird dann ignoriert und alle Besucher teilen sich EINEN Zähler - nur für lokale Entwicklung sinnvoll).
# Nicht raten, sondern messen: Einen Fehlversuch machen und prüfen, ob die IP-Zeile in LoginThrottle zur eigenen
# IP passt (Schlüssel = SHA-256 von "login:ip", einem Null-Byte und der IP). Hinter Cloudflare + Nginx Proxy
# Manager (mit dessen Real-IP-Erkennung) war die echte Besucher-IP der LETZTE Eintrag, also 1.
TRUST_PROXY_HOPS=1

# --- Konto-Verbund mit anderen Tools der Suite (optional, siehe README "Konten-Verbund") -----------------
# Ohne diese Werte arbeitet die App nur mit eigenen lokalen Konten - es gibt dann nicht einmal einen Login-Button
# für andere Tools. BASE_URL (oben) ist zugleich die Kennung dieser App gegenüber den anderen Tools.
SUITE_APP_NAME="RSVP-App"

# ANBIETER-Seite: Privater Signierschlüssel dieser App. Erzeugen mit:
#   node node_modules/suite-kit/bin/suite-keygen.js
# Geheim halten - er verlässt diese App nie. Der öffentliche Teil wird automatisch unter
# /.well-known/suite-identity veröffentlicht. Leer = diese App stellt keine Logins für andere Tools aus.
SUITE_SIGNING_KEY=
# Nur während einer Schlüsselrotation: der bisherige Schlüssel (2 Minuten genügen).
SUITE_SIGNING_KEY_PREVIOUS=

# ANBIETER-Seite: Kommagetrennte Origins der Tools, die Logins von hier empfangen dürfen,
# z.B. https://vote.deine-domain.de
SUITE_TRUSTED_APPS=

# EMPFÄNGER-Seite: Tools, mit deren Konten man sich hier anmelden darf. Entweder Origins kommagetrennt oder JSON
# für Einzeleinstellungen:
#   [{"issuer":"https://vote.deine-domain.de","label":"Abstimmungstool","autoProvision":false,"mapAdminRole":false}]
# autoProvision: erster Login legt automatisch ein Konto ohne Passwort an (Standard: true). Für rsvp-app empfohlen
#                false: neue Creator-Konten soll nur ein Admin anlegen; verknüpft werden bestehende Konten.
# mapAdminRole:  Admins des anderen Tools werden hier ebenfalls Admin (Standard: false).
SUITE_IDPS=
