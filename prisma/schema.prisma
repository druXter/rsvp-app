// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime
  location    String?
  description String?
  formConfig  String?  @default("{\"askEmail\":false,\"askPhone\":false,\"askDiet\":true,\"askAlcohol\":true}")
  reminderSent Boolean @default(false)
  autoReminder Boolean @default(false)
  reminderDays Int     @default(7)
  requireVerification Boolean @default(false)
  rsvps       Rsvp[]
  createdAt   DateTime @default(now())
  duration    Int      @default(4)
  maxCapacity        Int?
}

model Rsvp {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  name           String
  isAttending    Boolean
  dietaryOption  String?
  drinksAlcohol  Boolean?
  additionalInfo String?
  declineReason  String?
  email          String?
  phone          String?
  customAnswers  String?  
  createdAt      DateTime @default(now())
  plusOne        Boolean  @default(false)
  plusOneName    String?
  bringingItem   String?
  allergies      String?
  editToken      String   @unique @default(uuid())
  isVerified     Boolean   @default(false)
  verifyToken    String?   @unique
  verifiedAt     DateTime?
  isOnWaitlist       Boolean  @default(false)
}