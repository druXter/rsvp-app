// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ADMIN sieht/verwaltet alle Events & Reihen aller Konten. CREATOR verwaltet eigene
// Events & Reihen und kann sie mit anderen Konten teilen sowie neue Nutzer/Moderatoren
// anlegen (aber keine neuen Creator/Admin-Konten - das bleibt Admins vorbehalten, um
// die Anzahl eigenständiger Mandanten unter Kontrolle zu halten). MODERATOR besitzt
// keine eigenen Events, sondern ausschließlich per ResourceAccess geteilten Zugriff.
enum Role {
  ADMIN
  CREATOR
  MODERATOR
}

// Ein Benutzerkonto (Referat, Verein, Freund...). Registrierung ist nicht öffentlich -
// Konten werden ausschließlich von bereits eingeloggten Nutzern angelegt (siehe
// createUser-Action). Jeder Nutzer verwaltet primär seine eigenen Events/Reihen;
// zusätzlicher Zugriff auf fremde Ressourcen läuft ausschließlich über Role/ResourceAccess.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CREATOR)
  createdAt    DateTime @default(now())

  // Self-Service-Passwort-Reset (siehe #13) - ausdrücklich NIE für ADMIN-Konten vergeben,
  // dort bleibt ein Reset nur über direkten Server-Zugriff (set-role.js/create-user.js)
  // möglich, damit ein kompromittiertes Admin-Postfach nicht automatisch vollen Zugriff gibt.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Self-Service-E-Mail-Änderung (bei eingeloggten Nutzern JEDER Rolle, inkl. Admin -
  // anders als beim Passwort-Reset per Mail-Link reicht hier kein kompromittiertes
  // Postfach: erfordert eine aktive Session UND das aktuelle Passwort, siehe
  // requestEmailChange in app/admin/actions.ts). Die neue Adresse wird erst nach Klick auf
  // den an SIE verschickten Bestätigungslink wirksam.
  pendingEmail              String?
  emailChangeToken          String?   @unique
  emailChangeTokenExpiresAt DateTime?

  events            Event[]
  series            EventSeries[]
  pushSubscriptions PushSubscription[]
  sessions          Session[]
  resourceAccess    ResourceAccess[]
}

// Server-seitige Session: das Cookie trägt nur den opaken, unratbaren `token` -
// wer eingeloggt ist, ergibt sich ausschließlich aus einem DB-Lookup, nie aus dem
// Cookie-Inhalt selbst (verhindert Session-Fälschung durch Cookie-Manipulation).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Eine optionale Veranstaltungsreihe (mehrere Termine, gemeinsames Gast-Profil).
// Events ohne seriesId sind normale Einzel-Events und von diesem Modell unberührt.
model EventSeries {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Reihenweit EINMALIG abgefragte Profil-Felder (gelten für alle Termine der Reihe)
  askEmail            Boolean @default(false)
  askPhone            Boolean @default(false)
  askDiet             Boolean @default(true)
  askAllergies        Boolean @default(false)
  requireVerification Boolean @default(false)

  // Gruppen- & Vereins-Features gelten reihenweit statt pro Termin
  isGuestListVisible Boolean @default(false)
  eventPin           String?

  createdAt    DateTime          @default(now())
  events       Event[]
  participants Participant[]
  sharedWith   ResourceAccess[]
  guestMembers GuestUserSeries[]
}

model Event {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  date                DateTime
  location            String?
  description         String?
  formConfig          String?  @default("{\"askEmail\":false,\"askPhone\":false,\"askDiet\":true,\"askAlcohol\":true}")
  reminderSent        Boolean  @default(false)
  autoReminder        Boolean  @default(false)
  reminderDays        Int      @default(7)
  requireVerification Boolean  @default(false)
  rsvps               Rsvp[]
  createdAt           DateTime @default(now())
  duration            Int      @default(4)
  maxCapacity         Int?
  isGuestListVisible  Boolean  @default(false)
  eventPin            String?
  enableCheckin       Boolean  @default(false)

  // Wird bei jeder inhaltlichen Änderung (Titel/Datum/Dauer/Ort/Beschreibung, siehe
  // diffEventFields in app/admin/actions.ts) um 1 erhöht - dient als ICS-SEQUENCE, damit
  // Kalender-Apps eine neu verschickte .ics-Datei als Update des bestehenden Eintrags
  // erkennen statt einen Duplikat-Eintrag anzulegen (siehe app/lib/mail.ts).
  icsSequence Int @default(0)

  // Optionaler Link zu einer externen Abstimmung für GENAU diesen Termin (z.B. im
  // separaten "abstimmungstool" - eigenständiges Tool, siehe dessen README). Rein
  // additiv: ohne pollUrl ändert sich nichts. Ist pollUrl gesetzt, verlinkt die
  // Event-Seite nicht direkt darauf, sondern über /api/poll-link/[eventId] (siehe
  // dort) - der Redirect hängt für einen eingeloggten, verifizierten GuestUser einen
  // signierten Verifizierungs-Token an (siehe app/lib/poll-verification.ts), damit
  // eine dort passend markierte Abstimmung Mehrfachabstimmen ausschließen kann. Für
  // jeden anderen Aufrufer (nicht eingeloggt, unverifiziert) führt derselbe Link
  // einfach ohne Token zur Abstimmung - das Abstimmungstool selbst entscheidet, ob
  // das für diese eine Abstimmung reicht oder nicht.
  pollUrl   String?
  pollLabel String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Optionale Zugehörigkeit zu einer Veranstaltungsreihe. Ist seriesId gesetzt,
  // sind requireVerification/isGuestListVisible/eventPin auf DIESEM Event bedeutungslos -
  // stattdessen gelten die gleichnamigen Felder der EventSeries, und formConfig enthält
  // nur noch die pro Termin abgefragten Felder (askAlcohol, askPlusOne, askBringingItem).
  seriesId   String?
  series     EventSeries?     @relation(fields: [seriesId], references: [id])
  sharedWith ResourceAccess[]
}

// Die Identität eines Gasts. Bei Einzel-Events entsteht pro Anmeldung ein eigener
// Participant (seriesId = null). Innerhalb einer Reihe wird EIN Participant über
// mehrere Termine (Rsvps) hinweg wiederverwendet, damit Kontakt-/Profildaten nicht
// für jeden Termin erneut abgefragt werden müssen.
model Participant {
  id       String       @id @default(cuid())
  seriesId String?
  series   EventSeries? @relation(fields: [seriesId], references: [id])

  name          String
  email         String?
  phone         String?
  dietaryOption String?
  allergies     String?

  isVerified  Boolean   @default(false)
  verifyToken String?   @unique
  verifiedAt  DateTime?

  // Gesetzt, wenn diese Reihen-Identität zu einem eingeloggten Gäste-Konto (GuestUser)
  // gehört - siehe submitRsvp für die Auflösung ohne editToken über die Gast-Session.
  guestUserId String?
  guestUser   GuestUser? @relation(fields: [guestUserId], references: [id])

  editToken String   @unique @default(uuid())
  createdAt DateTime @default(now())
  rsvps     Rsvp[]

  pushSubscriptions ParticipantPushSubscription[]
}

// Push-Abo eines Gast-Geräts, verknüpft mit dem Participant statt (wie PushSubscription)
// mit einem admin-seitigen User - so funktioniert Gast-Push sowohl für anonyme
// editToken-Teilnehmer als auch für eingeloggte GuestUser gleichermaßen, ganz ohne
// Konto-Pflicht (siehe subscribeParticipantToPush in app/actions.ts). Bei einem
// Reihen-Termin deckt EIN Abo automatisch alle Termine der Reihe ab, da der Participant
// dort geteilt ist.
model ParticipantPushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
}

// Die Antwort eines Participants zu GENAU EINEM Termin (Zusage/Absage, Warteliste
// und alles, was pro Termin einzeln abgefragt wird).
model Rsvp {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  isAttending    Boolean
  drinksAlcohol  Boolean?
  additionalInfo String?
  declineReason  String?
  customAnswers  String?
  plusOne        Boolean   @default(false)
  plusOneName    String?
  bringingItem   String?
  isOnWaitlist   Boolean   @default(false)
  hasAttended    Boolean   @default(false)
  checkedInAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([eventId, participantId])
}

// Ein Gerät (Browser), auf dem sich EIN BESTIMMTER Nutzer für Web-Push-Benachrichtigungen
// angemeldet hat. Bei einer neuen Zu-/Absage wird nur der Owner des jeweiligen Events
// benachrichtigt (auf all seinen Geräten), nie fremde Nutzer.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

// Gewährt einem Nutzer Moderator-Rechte auf EIN fremdes Event ODER EINE fremde Reihe
// (nie beides in derselben Zeile). Zugriff auf eine Reihe gilt automatisch für alle
// ihre Termine, muss also nicht pro Termin einzeln vergeben werden. Wird ausschließlich
// vom Owner der Ressource oder einem Admin vergeben - siehe shareResource/unshareResource.
model ResourceAccess {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?       @relation(fields: [eventId], references: [id])
  seriesId  String?
  series    EventSeries? @relation(fields: [seriesId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, eventId])
  @@unique([userId, seriesId])
}

// Gastseitiges Login-Konto ("Nutzer", die vierte Rolle neben Admin/Creator/Moderator -
// siehe Role weiter oben, die ausschließlich das Admin-Dashboard betrifft). Komplett
// getrennt von User/Session (eigenes Cookie, eigene Route /mein-konto), damit Gast- und
// Admin-Sessions nie verwechselt werden können. Trägt das reihenübergreifende Profil
// ZENTRAL: submitRsvp befüllt den Participant einer Reihe daraus, sobald über die
// Gast-Session (ohne editToken) geantwortet wird, und spiegelt spätere Änderungen sofort
// auf alle Participant-Zeilen dieses Kontos zurück (siehe app/actions.ts, app/mein-konto/actions.ts).
model GuestUser {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String
  name          String
  phone         String?
  dietaryOption String?
  allergies     String?

  isVerified  Boolean   @default(false)
  verifyToken String?   @unique
  verifiedAt  DateTime?

  // Self-Service-Passwort-Reset (siehe #13, analoges Feldpaar wie bei User) - anders als
  // beim Admin-User gibt es hier keine Rolle, die vom Reset ausgeschlossen wird.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Self-Service-E-Mail-Änderung, analoges Feldpaar wie bei User (siehe dort) - wirksam
  // erst nach Klick auf den an die NEUE Adresse verschickten Bestätigungslink.
  pendingEmail              String?
  emailChangeToken          String?   @unique
  emailChangeTokenExpiresAt DateTime?

  // Startet bei @default(now()) (nicht null), damit ein Konto, das sich nach der
  // Registrierung nie wieder einloggt, ab der Registrierung selbst und nicht erst ab
  // einem nie eintretenden ersten Login gezählt wird - siehe die automatische
  // Löschung inaktiver Konten in app/api/cron/cleanup/route.ts (#13/DSGVO-Speicherbegrenzung).
  lastLoginAt DateTime @default(now())

  createdAt DateTime @default(now())

  seriesMemberships GuestUserSeries[]
  participants      Participant[]
  sessions          GuestSession[]
}

// Mitgliedschaft eines Nutzer-Kontos in einer Reihe (n:m - ein Konto kann mehreren Reihen
// angehören, ohne dass dafür mehrere Konten nötig wären). Entsteht entweder bei der
// Selbstregistrierung auf der jeweiligen Reihen-Seite oder wird von einem Creator/Moderator
// nachträglich für eine weitere Reihe vergeben (addGuestUserToSeries), oder automatisch
// beim ersten Beantworten eines Termins dieser Reihe über eine bestehende Gast-Session.
model GuestUserSeries {
  id          String      @id @default(cuid())
  guestUserId String
  guestUser   GuestUser   @relation(fields: [guestUserId], references: [id])
  seriesId    String
  series      EventSeries @relation(fields: [seriesId], references: [id])
  createdAt   DateTime    @default(now())

  @@unique([guestUserId, seriesId])
}

// Server-seitige Gast-Session, strikt getrennt vom Admin-Session-Modell - auch hier trägt
// das Cookie nur den opaken Token, nie eine Kontoidentität direkt.
model GuestSession {
  id          String    @id @default(cuid())
  token       String    @unique
  guestUserId String
  guestUser   GuestUser @relation(fields: [guestUserId], references: [id])
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}
